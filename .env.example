REW_ENVIRONMENT=development
REW_DATABASE_URL=postgresql+psycopg://reviews:reviews@db:5432/reviews

# Required to use /admin endpoints. Generate a long random value.
REW_ADMIN_API_KEY=change-me-to-a-long-random-secret

# Optional extra secret mixed into stored API key hashes.
REW_API_KEY_PEPPER=change-me-too

# 2GIS works without an API key by opening the public page in Chromium.
REW_TWOGIS_FETCH_MODE=browser
REW_TWOGIS_BROWSER_TIMEOUT_SECONDS=60
# Keep false in production: Docker provides an invisible Xvfb display.
REW_TWOGIS_BROWSER_HEADLESS=false

# Optional. Set mode to "api" (or "auto") only if you have an official key.
REW_TWOGIS_REVIEWS_API_KEY=

REW_SYNC_INTERVAL_MINUTES=1440
REW_SYNC_DELAY_MIN_SECONDS=20
REW_SYNC_DELAY_MAX_SECONDS=60
REW_PROVIDER_REQUEST_DELAY_SECONDS=0.35
REW_MAX_REVIEWS_PER_SOURCE=5000
REW_HTTP_TIMEOUT_SECONDS=20
REW_HTTP_RETRY_ATTEMPTS=3
